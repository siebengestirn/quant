{
  "buildPresets": [
    {
      "configurePreset": "default",
      "name": "default"
    },
    {
      "configurePreset": "release",
      "name": "release"
    },
    {
      "configurePreset": "sanitizers",
      "name": "sanitizers"
    },
    {
      "configurePreset": "portable-ci",
      "name": "portable-ci"
    }
  ],
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "displayName": "QUANT local default",
      "generator": "Ninja",
      "name": "default"
    },
    {
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QUANT_WITH_KDBX": "OFF"
      },
      "displayName": "QUANT portable release",
      "inherits": "default",
      "name": "release"
    },
    {
      "binaryDir": "${sourceDir}/build-san",
      "cacheVariables": {
        "QUANT_SANITIZERS": "ON"
      },
      "displayName": "QUANT ASan/UBSan",
      "inherits": "default",
      "name": "sanitizers"
    },
    {
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": {
        "QUANT_WITH_KDBX": "OFF"
      },
      "displayName": "QUANT portable CI parity",
      "inherits": "release",
      "name": "portable-ci"
    }
  ],
  "testPresets": [
    {
      "configurePreset": "default",
      "name": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "configurePreset": "portable-ci",
      "name": "portable-ci",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "version": 3
}
