{
  "schema_version": 1,
  "canonical_repository": "siebengestirn/quant",
  "branch": {
    "base": "main",
    "allowed_topic_prefixes": [
      "feat",
      "fix",
      "docs",
      "test",
      "ci",
      "chore",
      "correctness"
    ],
    "topic_pattern": "^[a-z0-9][a-z0-9._/-]*$",
    "one_coherent_change_per_branch": true,
    "temporary": true,
    "pull_request_required": true,
    "no_permanent_develop_or_release_branches": true,
    "active_topic_branches": [],
    "active_topic_rationale": "PR #1 merged into main; current remediation branch uses the allowed fix/ prefix."
  },
  "history": {
    "merge_strategy": "merge_commit",
    "require_linear_main": false,
    "published_commit_rewrite": false,
    "forbidden_operations": [
      "rebase published commits",
      "reset --hard on shared work",
      "amend published commits",
      "force push",
      "direct commits to main"
    ],
    "merge_conditions": [
      "a pull request is required for every change to main",
      "CI status checks must pass on the exact PR head",
      "no force-pushes to main",
      "no rewriting published commits",
      "only reviewed PR merge commits may enter main",
      "feature branches must be up to date with main when CI strict mode is enabled"
    ],
    "squash_merge": false,
    "rebase_merge": false,
    "force_push": false,
    "direct_main_commits": false
  },
  "working_tree": {
    "must_be_clean_before_start": true,
    "must_be_clean_after_finish": true,
    "start_sequence": [
      "git fetch --prune origin",
      "git switch main",
      "git pull --ff-only origin main",
      "git status --short --branch"
    ],
    "finish_check": "git status --porcelain",
    "no_stash_at_finish": true
  },
  "inventory": {
    "target_local_branches": [
      "main"
    ],
    "target_remote_names": [
      "origin"
    ],
    "target_remote_tracking_branches": [
      "origin/main"
    ],
    "target_worktree_count": 1,
    "target_stash_count": 0,
    "target_tracked_generated_count": 0
  },
  "generated_paths": {
    "forbidden_components": [
      ".DS_Store",
      ".vscode",
      "__pycache__",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      ".cache",
      ".venv",
      "venv",
      "target",
      "build",
      "build-san",
      "dist",
      "data"
    ],
    "forbidden_component_prefixes": [
      "build-"
    ],
    "forbidden_suffixes": [
      ".pyc",
      ".pyo"
    ]
  },
  "automation": {
    "remote_tracking_prune": "git fetch --prune origin",
    "prune_may_delete_remote_tracking_refs_only": true,
    "must_not_delete_local_branches": true,
    "must_not_delete_remote_branches": true,
    "must_not_rewrite_history": true,
    "must_not_stash_or_discard_changes": true
  },
  "commit_subject": {
    "pattern": "^(feat|fix|docs|test|refactor|perf|build|ci|chore|correctness)(\\([a-z0-9][a-z0-9._/-]*\\))?: .{1,64}$",
    "required_author_email": "22kartikjangid@gmail.com",
    "maximum_length": 72,
    "forbidden_exact_subjects": [
      "fix",
      "update",
      "cleanup",
      "final",
      "final fix"
    ],
    "grandfathered_through_commit": "f321d0c",
    "grandfather_reason": "Published correctness commits predate adoption of this policy and are not rewritten.",
    "validate_unmerged_topic_commits_against": "main"
  },
  "pr_review": {
    "self_review_checklist_required": true,
    "ci_evidence_required": true,
    "required_approving_reviews": 0,
    "reason": "Single-developer repository: explicit self-review plus independent CI and, for financial-critical work, an independent reviewer assigned by the owner."
  },
  "milestone_tags": {
    "after_verified_main_merge_only": true,
    "examples": [
      "correctness-gate0",
      "paper-readiness"
    ]
  },
  "github_protection_audit": {
    "restrict_direct_main_pushes": true,
    "require_pull_request": true,
    "require_status_checks": true,
    "required_status_checks": [
      "core build and tests",
      "ASan/UBSan"
    ],
    "require_latest_checks": true,
    "prevent_force_pushes": true,
    "prevent_main_deletion": true,
    "allowed_merge_method": "merge_commit",
    "require_linear_history": false,
    "require_conversation_resolution": true
  }
}
